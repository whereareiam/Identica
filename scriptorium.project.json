{
  "name": "Identica",
  "description": "Provider-oriented Minecraft identity plugin.",
  "logo": "docs/assets/logo.png",
  "favicon": "docs/assets/favicon.ico",
  "state": {
    "bundling": {
      "captions": [
        "Linking identity to the right provider.",
        "Asking the providers who you really are.",
        "Aligning providers, pipelines, and poor life choices.",
        "Checking whether this username has paperwork.",
        "Waking the routing goblins.",
        "Reversing the authentication polarity.",
        "Negotiating with the verification gremlins."
      ]
    }
  },
  "urls": {
    "github": "https://github.com/whereareiam/Identica"
  },
  "links": [
    {
      "type": "icon",
      "label": "GitHub",
      "icon": "github",
      "url": "https://github.com/whereareiam/Identica",
      "external": true
    },
    {
      "type": "icon",
      "label": "Discord",
      "icon": "discord",
      "url": "https://discord.arcadeya.com",
      "external": true
    }
  ],
  "i18n": {
    "default": "en",
    "languages": {
      "en": { "label": "English" },
      "ru": { "label": "Русский" }
    }
  },
  "versions": {
    "home": "dev",
    "include": [
      { "type": "branch", "pattern": "release/*" },
      { "type": "tag", "pattern": "*" }
    ],
    "meta": {
      "dev": {
        "label": "Development",
        "theme": {
          "primary": "hsl(28 100% 56%)",
          "primaryForeground": "hsl(0 0% 7%)",
          "ring": "hsl(28 100% 56%)",
          "accent": "hsla(28 100% 56% / 0.14)",
          "accentForeground": "hsl(28 100% 86%)"
        }
      }
    }
  }
}
