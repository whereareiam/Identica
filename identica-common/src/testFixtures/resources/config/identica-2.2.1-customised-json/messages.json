{
  "_version": 1,
  "prefix": "<green>Identica</green> <dark_gray>|  [customised]",
  "format": {
    "temporal": {
      "date": "yyyy-MM-dd",
      "dateTime": "yyyy-MM-dd HH:mm"
    }
  },
  "commands": {
    "currentSessionRequired": "{prefix}<white>You must have an <red>active session</red> to use this command.</white> [customised]",
    "exceptions": {
      "noPermission": "{prefix}<white>You don't have \"<gray>{content}</gray>\" permission to use this command.</white> [customised]",
      "executionError": "{prefix}<white>An error occurred while executing the command:</white> <gray>{content}</gray> [customised]",
      "invalidSyntax": "{prefix}<white>Invalid syntax, please use:</white> <gray>/{content}</gray> [customised]",
      "invalidSyntaxBoolean": "{prefix}<white>You tried to use <gray>{content}</gray> as a boolean, but it's not a valid value, please use <green>true</green> or <red>false</red>.</white> [customised]",
      "invalidSyntaxNumber": "{prefix}<white>You tried to use <gray>{content}</gray> as a number, but it's not a valid value, please use a valid number.</white> [customised]",
      "invalidSyntaxString": "{prefix}<white>You tried to use <gray>{content}</gray> as a string, but it's not a valid value, please use a valid string.</white> [customised]",
      "invalidSender": "{prefix}<white>You cannot execute this command from this context.</white> [customised]"
    },
    "pagination": {
      "showPaginationIfOnePage": true,
      "format": "\n {previous}<white>Pagination</white> <gray>[{current}/{max}]</gray>{next} \n [customised]",
      "showPreviousEvenIfFirst": true,
      "previousTagFormat": "<red><click:run_command:/identica help {previousPage}>«</red>  [customised]",
      "showNextEvenIfLast": true,
      "nextTagFormat": " <green><click:run_command:/identica help {nextPage}>»</green> [customised]"
    },
    "help": {
      "format": [
        " ",
        " <green><bold>Identica</bold> <white>Command help",
        " ",
        "{commands}",
        "{pagination}",
        "[customised]"
      ],
      "commandFormat": "  <yellow>/{command}{arguments}</yellow> <dark_gray>- <white>{description} [customised]",
      "noCommands": "  <red>No commands found</red> [customised]",
      "argumentFormat": {
        "argument": "<gray>[{argument}]</gray> [customised]",
        "optionalArgument": "<gray>({argument})</gray> [customised]"
      },
      "commandsPerPage": 10
    },
    "enroll": {
      "noPending": "{prefix}<white>No pending enrollment available.</white> [customised]",
      "completed": "{prefix}<white>Enrollment completed.</white> [customised]"
    },
    "availability": {
      "username": {
        "free": "{prefix}<white>Username <gray>{username}</gray> is available.</white> [customised]",
        "taken": "{prefix}<white>Username <gray>{username}</gray> is already taken.</white> [customised]"
      }
    },
    "migration": {
      "list": {
        "body": [
          " ",
          " <green><bold>Identica</bold>",
          " ",
          "  <white>Provider links for <aqua>{target}</aqua>:</white>",
          "{entries}",
          " ",
          "[customised]"
        ],
        "entry": {
          "format": "  <dark_gray>▪</dark_gray> <white>{providerName}</white> <gray>({providerId})</gray> <green>{primary}</green> [customised]",
          "emptyFormat": "  <dark_gray>▪</dark_gray> <white>{providerId}</white> [customised]"
        }
      },
      "links": {
        "noLinks": "{prefix}<white>No provider links found for <gray>{target}</gray>.</white> [customised]",
        "notLinked": "{prefix}<white><gold>{provider}</gold> is not linked for <gray>{target}</gray>.</white> [customised]"
      },
      "start": {
        "pendingExists": "{prefix}<white>Migration already pending for <gray>{target}</gray>.</white> [customised]",
        "started": "{prefix}<white>Migration started for <gray>{target}</gray> to <gold>{provider}</gold>.</white> [customised]",
        "providerUnsupported": "{prefix}<white><gold>{provider}</gold> does not support migration.</white> [customised]"
      },
      "cancel": {
        "cancelled": "{prefix}<white>Migration cancelled for <gray>{target}</gray>.</white> [customised]",
        "noPending": "{prefix}<white>No pending migration for <gray>{target}</gray>.</white> [customised]"
      },
      "primary": {
        "set": "{prefix}<white>Primary provider set to <gold>{provider}</gold> for <gray>{target}</gray>.</white> [customised]",
        "alreadyPrimary": "{prefix}<white><gold>{provider}</gold> is already primary for <gray>{target}</gray>.</white> [customised]"
      },
      "drop": {
        "dropped": "{prefix}<white>Dropped <gold>{provider}</gold> for <gray>{target}</gray>.</white> [customised]",
        "primaryDenied": "{prefix}<white>Cannot drop primary provider. Change primary first.</white> [customised]",
        "lastLinkDenied": "{prefix}<white>Cannot drop the only provider link.</white> [customised]"
      },
      "targetNotFound": "{prefix}<white>No account found for <gray>{target}</gray>.</white> [customised]",
      "locked": "{prefix}<white>Username is not available. Migration is locked.</white> [customised]"
    },
    "reload": {
      "success": "{prefix}<white>Configuration reloaded <green>successfully</green>! [customised]",
      "error": "{prefix}<white>An <red>error occurred</red> while reloading: <gray>{error}</gray> [customised]"
    },
