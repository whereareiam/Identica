          "body": [
            " ",
            " <green><bold>Identica</bold>",
            " ",
            "  <white>Found <gray>{count}</gray> accounts for</white>",
            "  <white>username <gray>{target}</gray></white>",
            " ",
            "  <white>Matches:</white>",
            "{entries}",
