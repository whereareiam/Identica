          " ",
          "  <click:run_command:/identica admin clear confirm><green>[CONFIRM]</green></click>       <click:run_command:/identica admin clear cancel><red>[CANCEL]</red></click>",
          " ",
          "[customised]"
        ],
        "noPending": "{prefix}<white>No pending clear request.</white> [customised]",
        "expired": "{prefix}<white>Clear request expired, please run the command again.</white> [customised]",
        "cancelled": "{prefix}<white>Clear request cancelled.</white> [customised]",
        "notFound": "{prefix}<white>No account found for <gray>{target}</gray>.</white> [customised]",
