        "success": "{prefix}<white>Cleared <gold>{scope}</gold> for <gray>{uniqueId}</gray>.</white> [customised]",
        "error": "{prefix}<white>An <red>error occurred</red> while clearing: <gray>{error}</gray></white> [customised]",
        "disconnect": [
          "<green>ɪᴅᴇɴᴛɪᴄᴀ",
          "",
          "<white>Your session has been cleared.</white>",
          "<white>Please rejoin to continue.</white>",
          "",
          "<dark_gray>discord.arcadeya.com",
          "[customised]"
        ]
      },
