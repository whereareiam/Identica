        "status": {
          "disabled": "{prefix}<white>Credential migration is <red>disabled</red>.</white>",
          "mismatch": "{prefix}<white>Migration passwords do not <red>match</red>.</white>",
          "noPending": "{prefix}<white>No pending credential migration password step.</white>"
