          "body": [
            " ",
            " <green><bold>Identica</bold>",
            " ",
            "  <white>Found <gray>{count}</gray> sessions for</white>",
            "  <white>username <gray>{target}</gray></white>",
            " ",
            "  <white>Matches:</white>",
