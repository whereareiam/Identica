          "entry": {
            "format": "  <click:run_command:/{command} {uniqueId}>▪ <gray>{uniqueId}</gray>: <green>{username}</green></click> [customised]",
            "emptyFormat": "  <click:run_command:/{command} {uniqueId}>▪ <gray>{uniqueId}</gray></click> [customised]"
          }
